{
	"name": "rpg-sage",
	"version": "1.16.11",
	"description": "RPG Sage Bot",
	"type": "module",
	"main": "./build/app.mjs",
	"files": [
		"build"
	],
	"directories": {
		"lib": "build"
	},
	"keywords": [
		"discord",
		"bot",
		"rpg",
		"ttrpg",
		"play-by-post",
		"pbp",
		"play-by-discord",
		"pbd",
		"pathfinder",
		"pathfinder2e",
		"pf2e",
		"starfinder",
		"starfinder2e",
		"sf2e",
		"essence20",
		"e20",
		"dnd5e",
		"vtm5e"
	],
	"private": true,
	"author": "Randal T Meyer <randal.t.meyer@gmail.com> (https://rpgsage.io)",
	"contributors": [],
	"license": "GPL-3.0-only",
	"bugs": {
		"url": "https://github.com/rpg-sage-creative/rpg-sage/issues",
		"email": "bugs@rpgsage.io"
	},
	"homepage": "https://github.com/rpg-sage-creative/rpg-sage#readme",
	"funding": {
		"type": "patreon",
		"url": "https://www.patreon.com/rpgsage"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/rpg-sage-creative/rpg-sage.git"
	},
	"publishConfig": {
		"@rpg-sage-creative:registry": "https://npm.pkg.github.com"
	},
	"-packageManager": "pnpm@10.29.1",
	"engines": {
		"node": ">=24",
		"pnpm": ">=10"
	},
	"devDependencies": {
		"@rsc-utils/dev-scripts": "github:rpg-sage-creative/dev-scripts#semver:^1.6.0",
		"@types/node": "^24.12.0",
		"typescript": "^7.0.2",
		"vitest": "^4.1.10"
	},
	"dependencies": {
	},
	"exifreader": {
		"include": {
			"file": true,
			"gif": true,
			"jpeg": true,
			"png": true,
			"png_file": true,
			"webp": true
		}
	},
	"scripts": {
		"scrub": "pnpm run '/^scrub::.*/'",
		"scrub::packages": "pnpm -r run '/^scrub::.*/'",
		"scrub::node_modules": "rm -rf node_modules",
		"scrub::npm": "rm -f package-lock.json",
		"scrub::pnpm": "rm -f pnpm-lock.yaml",
		"scrub::logs": "rm -rf ./logs/*.log",
		"postscrub": "git submodule update --init --recursive && pnpm install --prefer-offline",
		"scrubIfMissing": "[ -d './node_modules' ] && [ -f './pnpm-lock.yaml' ] || pnpm scrub",

		"prebuild": "pnpm scrubIfMissing && pnpm run -r '/^build::.*/'",
		"build": "[ -f './tsconfig.mono.json' ] && tsc -b --force tsconfig.mono.json",
		"build:fresh": "pnpm scrub && pnpm build",

		"pretest": "pnpm scrub::logs",
		"test": "pnpm build && pnpm vitest --run --globals",

		"release": "pnpm dev-scripts create-release",
		"refresh-tags": "pnpm dev-scripts refresh-tags",
		"deploy:dev": "pnpm dev-scripts deploy dev",
		"deploy:beta": "git checkout beta && git merge develop && git push && git checkout develop && pnpm dev-scripts deploy beta",
		"deploy:stable": "pnpm dev-scripts deploy stable",

		"prestart": "pnpm run '/^start::.*/'",
		"start::env": "pnpm dev-scripts write-env-json local",
		"start::build": "pnpm build",
		"start": "node ./packages/@rsc-apps/bot/build/app.js codeName=dev --getFromEnvJson",

		"predocker:setup": "docker compose down; docker compose up -d",
		"docker:setup": "pm2 deploy bot.config.cjs docker setup",
		"docker:start": "pnpm deploy docker dev bot pnpm --noPrompt",
		"docker:stop": "pm2 deploy bot.config.cjs docker run 'pm2 stop sage-bot-dev'",

		"data:stack": "bash ./scripts/data-update.sh",
		"commands:build": "node ./packages/@rsc-apps/app-commands/build/build.mjs codeName=dev --getFromEnvJson",
		"-start:dev:all": "node ./packages/@rsc-apps/bot/build/app.js codeName=dev --getFromEnvJson --spawnServices"
	}
}
