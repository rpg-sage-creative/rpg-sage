{
	"compileOnSave": false,
	"compilerOptions": {
		"alwaysStrict": true,
		"allowSyntheticDefaultImports": true,

		"composite": true,

		"declaration": true,
		// "declarationDir": "./types",
		// "declarationMap": true,

		// "esModuleInterop": true,

		"forceConsistentCasingInFileNames": true,

		"incremental": true,

		// "importsNotUsedAsValues": "error",
		// "verbatimModuleSyntax": true,

		"lib": [ "ES2025" ],
		// "locale": "en-US",

		"module": "nodenext",
		"moduleResolution": "nodenext",

		"newLine": "LF",
		"noFallthroughCasesInSwitch": true,
		"noImplicitAny": true,
		// "noImplicitOverride": true,
		"noImplicitReturns": true,
		"noImplicitThis": true,
		// "noUncheckedIndexedAccess": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,

		// must be overidden build extended tsconfig.mono.json files
		"outDir": "./build",

		"pretty": true,

		"removeComments": false,

		// must be overidden build extended tsconfig.mono.json files
		"rootDir": "./src",

		"skipLibCheck": true,

		"sourceMap": false,
		"strict": true,
		"strictBindCallApply": true,
		"strictFunctionTypes": true,
		"strictNullChecks": true,
		"strictPropertyInitialization": true,
		"stripInternal": true,

		"target": "ES2025",
		"types": ["node"],

		"verbatimModuleSyntax": true
	},
	// must be overidden build extended tsconfig.mono.json files
	"exclude": [
	],
	// must be overidden build extended tsconfig.mono.json files
	"include": [
		"./src"
	],
	"references": [

		{ "path": "./packages/@rsc-utils/cache-utils" },
		{ "path": "./packages/@rsc-utils/iterator-utils" },
		{ "path": "./packages/@rsc-utils/id-utils" },


		// ensure the rsc-utils stack
		{ "path": "./packages/@rsc-chat/discord-utils" },
		// @rsc-utils/discord-utils triggers @rsc-utils/io-utils
		// @rsc-utils/io-utils triggers @rsc-utils/core-utils
		// @rsc-utils/core-utils triggers @rsc-utils/type-utils
		// @rsc-utils/type-utils triggers @rsc-utils/template-literal-utils

		{ "path": "./packages/@rsc-sage/core" },
		{ "path": "./packages/@rsc-sage/data" },
		{ "path": "./packages/@rsc-sage/env" },
		{ "path": "./packages/@rsc-sage/localization" },
		{ "path": "./packages/@rsc-utils/game-utils" },
		{ "path": "./packages/@rsc-utils/map-utils" },
		{ "path": "./packages/@rsc-apps/bot" },
		{ "path": "./packages/@rsc-apps/commands" },
		{ "path": "./packages/@rsc-apps/map-server" },
		{ "path": "./packages/@rsc-apps/pixels-relay-server" },
	]
}