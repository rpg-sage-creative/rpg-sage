{
	"compileOnSave": false,
	"compilerOptions": {
		"alwaysStrict": true,
		"allowSyntheticDefaultImports": true,

		"composite": true,

		"declaration": true,
		// "declarationDir": "./types",
		// "declarationMap": true,

		// "esModuleInterop": true,

		"forceConsistentCasingInFileNames": true,

		"incremental": true,

		// "importsNotUsedAsValues": "error",
		// "verbatimModuleSyntax": true,

		"lib": [ "ES2025" ],
		// "locale": "en-US",

		"module": "nodenext",
		"moduleResolution": "nodenext",

		"newLine": "LF",
		"noFallthroughCasesInSwitch": true,
		"noImplicitAny": true,
		// "noImplicitOverride": true,
		"noImplicitReturns": true,
		"noImplicitThis": true,
		// "noUncheckedIndexedAccess": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,

		// must be overidden by extended tsconfig.*.json files
		"outDir": "./build",

		"pretty": true,

		"removeComments": false,

		// must be overidden by extended tsconfig.*.json files
		"rootDir": "./src",

		"skipLibCheck": true,

		"sourceMap": false,
		"strict": true,
		"strictBindCallApply": true,
		"strictFunctionTypes": true,
		"strictNullChecks": true,
		"strictPropertyInitialization": true,
		"stripInternal": true,

		"target": "ES2025",
		"types": ["node"],

		"verbatimModuleSyntax": true
	},
	// must be overidden by extended tsconfig.*.json files
	"exclude": [
	],
	// must be overidden by extended tsconfig.*.json files
	"include": [
		"./src"
	],
	"references": [

		// no dependencies (build first)
		{ "path": "./packages/@rsc-utils/aws-utils" },
		{ "path": "./packages/@rsc-utils/date-utils" },
		{ "path": "./packages/@rsc-utils/error-utils" },
		{ "path": "./packages/@rsc-utils/json-utils" },
		{ "path": "./packages/@rsc-utils/language-utils" },
		{ "path": "./packages/@rsc-utils/token-string-utils" },
		{ "path": "./packages/@rsc-utils/type-utils" },
		{ "path": "./packages/@rsc-utils/whitespace-string-utils" },

		// uses/triggers error
		{ "path": "./packages/@rsc-utils/charset-utils" },
		{ "path": "./packages/@rsc-utils/regexp-utils" },

		// uses/triggers aws/error/json
		{ "path": "./packages/@rsc-utils/logger-utils" },

		// uses/triggers logger
		{ "path": "./packages/@rsc-utils/progress-utils" },

		// uses/triggers json/logger/type
		{ "path": "./packages/@rsc-utils/fs-utils" },

		// uses/triggers type
		{ "path": "./packages/@rsc-utils/collection-utils" },
		{ "path": "./packages/@rsc-utils/git-utils" }, // also json
		{ "path": "./packages/@rsc-utils/id-utils" }, // also regexp
		{ "path": "./packages/@rsc-utils/quoted-string-utils" },
		{ "path": "./packages/@rsc-utils/random-utils" },

		// uses/triggers regexp/type
		{ "path": "./packages/@rsc-utils/color-utils" },

		// uses/triggers regexp
		{ "path": "./packages/@rsc-utils/dsv-utils" },
		{ "path": "./packages/@rsc-utils/url-utils" },

		// uses/triggers collection/id/type
		{ "path": "./packages/@rsc-utils/class-utils" },

		// uses/triggers charset/type
		{ "path": "./packages/@rsc-utils/number-utils" },

		// uses/triggers quoted-string/regexp/token-string/type/whitespace-string
		{ "path": "./packages/@rsc-utils/arg-utils" },

		// uses/triggers error/fs/json/logger/progress/type
		{ "path": "./packages/@rsc-utils/https-utils" },

		// uses/triggers error/fs/https/id/json/logger/progress/type
		{ "path": "./packages/@rsc-utils/cache-utils" },

		// uses/triggers arg/charset/error/json/number/quoted-string/regexp/token-string/type/whitespace-string
		{ "path": "./packages/@rsc-utils/string-utils" },

		// uses/triggers collection/color/logger/type
		{ "path": "./packages/@rsc-utils/render-utils" },

		// uses/triggers collection/language/quoted-string/token-string/type/whitespace-string
		{ "path": "./packages/@rsc-utils/search-utils" },

		// uses/triggers https/json/logger/random/type
		{ "path": "./packages/@rsc-utils/map-utils" },

		// uses/triggers arg/aws/git/id/json/logger/type
		{ "path": "./packages/@rsc-sage/env" },

		// uses/triggers aws/class/collection/color/date/fs/id/json/logger/string/type/url + env
		{ "path": "./packages/@rsc-sage/data" },

		// uses/triggers env/error/fs/https/id/json/logger/regexp/string/token-string/type/url
		{ "path": "./packages/@rsc-chat/discord-utils" },

		// uses/triggers data + arg/charset/class/collection/color/date/error/id/json/logger/number/quoted-string/random/regexp/string/token-string/type/url/whitespace-string
		{ "path": "./packages/@rsc-utils/game-utils" },

		// uses/triggers string/type
		{ "path": "./packages/@rsc-sage/localization" },

		// uses/triggers discord-utils/data/env/localization + the rsc-utils stack
		{ "path": "./packages/@rsc-sage/core" },

		// apps (build last)
		{ "path": "./packages/@rsc-apps/commands" },
		{ "path": "./packages/@rsc-apps/bot" },
		{ "path": "./packages/@rsc-apps/map-server" },
		{ "path": "./packages/@rsc-apps/pixels-relay-server" },

		// not referenced here:
		// @rsc-tools/dev-scripts is built separately via the build-tools script (bootstraps this build)
		// tools/@rsc-tools/dynamic-test and tools/@rsc-tools/release have no tsconfig.json
		// packages/@rsc-chat/chat-utils is an empty directory (no package.json or src)
	]
}