{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "test-all",
			"command": "pnpm",
			"args": ["test"],
			"type": "shell",
			"group": "test",
			"presentation": {
				"echo": true,
				"reveal": "always",
				"focus": false,
				"panel": "shared",
				"showReuseMessage": false,
				"clear": false
			}
		},
		{
			"label": "bot-start",
			"command": "pnpm",
			"args": ["start"],
			"group": {
				"kind": "test",
				"isDefault": "packages/@rsc-apps/bot/**/*.*"
			},
			"presentation": {
				"echo": true,
				"reveal": "always",
				"focus": false,
				"panel": "shared",
				"showReuseMessage": false,
				"clear": false
			}
		},
		{
			"label": "dynamic-test.test.js",
			"command": "pnpm",
			"args": ["dynamic-test", "${file}"],
			"type": "shell",
			"group": {
				"kind": "test",
				"isDefault": "**/test/**/*.test.js"
			},
			"presentation": {
				"echo": true,
				"reveal": "always",
				"focus": false,
				"panel": "shared",
				"showReuseMessage": false,
				"clear": false
			}
		},
		{
			"label": "dynamic-test.test.ts",
			"command": "pnpm",
			"args": ["dynamic-test", "${file}"],
			"type": "shell",
			"group": {
				"kind": "test",
				"isDefault": "**/test/**/*.test.ts"
			},
			"presentation": {
				"echo": true,
				"reveal": "always",
				"focus": false,
				"panel": "shared",
				"showReuseMessage": false,
				"clear": false
			}
		},
		{
			"label": "dynamic-test",
			"command": "pnpm",
			"args": [ "dynamic-test", "${file}"],
			"type": "shell",
			"group": {
				"kind": "test",
				"isDefault": "**/src/**/*.ts"
			},
			"presentation": {
				"echo": true,
				"reveal": "always",
				"focus": false,
				"panel": "shared",
				"showReuseMessage": false,
				"clear": false
			}
		},
		{
			"label": "full-test",
			"command": "pnpm",
			"args": [ "test" ],
			"type": "shell",
			"group": {
				"kind": "test",
				"isDefault": true
			},
			"presentation": {
				"echo": true,
				"reveal": "always",
				"focus": false,
				"panel": "shared",
				"showReuseMessage": false,
				"clear": false
			}
		},
		{
			"label": "run-build",
			"command": "pnpm",
			"args": ["build"],
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"presentation": {
				"echo": true,
				"reveal": "always",
				"focus": false,
				"panel": "shared",
				"showReuseMessage": false,
				"clear": false
			}
		}
	]
}