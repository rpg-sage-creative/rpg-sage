{
	"name": "@rsc-apps/pixels-relay-server",
	"version": "0.0.0",
	"private": true,
	"main": "build/app.js",
	"type": "module",
	"devDependencies": {
		"@rsc-utils/dev-scripts": "github:rpg-sage-creative/dev-scripts#semver:^1.4.2",
		"@types/node": "^24.12.0",
		"typescript": "^5.9.3"
	},
	"dependencies": {
		"@rsc-utils/core-utils": "github:rpg-sage-creative/core-utils#semver:^1.7.0",
		"@rsc-sage/core": "../sage-core"
	},
	"scripts": {
		"scrub::node_modules": "rm -rf node_modules",
		"scrub::npm": "rm -f package-lock.json",
		"scrub::pnpm": "rm -f pnpm-lock.yaml",

		"build::clean-build-folder": "rm -rf build",
		"build::clean-build-info": "rm -f *.tsbuildinfo",
		"-build::create-indexes": "[ -d './src' ] && pnpm dev-scripts create-indexes"
	}
}