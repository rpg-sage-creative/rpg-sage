/*
Each package/submodule in rpg-sage will use tsconfig.mono.json to ensure proper build order.
*/
{
	"extends": "../../../tsconfig.json",
	"compilerOptions": {
		"composite": true,
		"outDir": "./build",
		"rootDir": "./src",
	},
	"exclude": [
		"./test"
	],
	"include": [
		"./src"
	],
	"references": [
		{ "path": "../../@rsc-utils/type-utils/tsconfig.mono.json" },
	],
}
